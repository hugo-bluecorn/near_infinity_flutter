# Body below is Flutter's canonical app template, verbatim:
#   flutter/flutter packages/flutter_tools/templates/app/.gitignore.tmpl
#   pinned from the ai-context snapshot 36b35dd79ff (2026-07-16)
# This is what `flutter create` generates. Keep it in sync rather than hand-editing;
# project-specific additions go in the marked section at the bottom.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Project-specific additions (not from the Flutter template)
# ---------------------------------------------------------------------------

# fvm — ignore the resolved SDK, keep .fvmrc under version control
.fvm/flutter_sdk
.fvm/versions

# reference/ — local read-only third-party reference material (see reference/README.md
# for provenance and refetch instructions). Carries no license grant for redistribution,
# so the content stays out of the repository; only the README is tracked.
/reference/*
!/reference/README.md

# Notes:
# - pubspec.lock is deliberately NOT ignored: this is an application, and
#   applications commit their lockfile so builds are reproducible.
# - `flutter create` writes its own per-platform ignores (e.g. linux/.gitignore
#   for flutter/ephemeral); those arrive with the scaffold and are not duplicated here.
